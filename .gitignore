node_modules/
.pnpm-store/

# Next.js
.next/
out/
next-env.d.ts

# build
dist/
build/
*.tsbuildinfo

# ambiente — mai committare i segreti
.env
.env.*
!.env.example

# test
coverage/
playwright-report/
test-results/
blob-report/
.playwright/

# verifica visiva: gli screenshot si rigenerano, non si versionano
screenshot/

# deploy
.vercel/
deploy/.env.prod
deploy/fleet.txt
controllo/.env
deploy/.dns-snapshot/

# sistema
.DS_Store
Thumbs.db
*.log

# La negazione deve restare l'ULTIMA regola sui .env: vince l'ultima che corrisponde, e
# `.env.example` è l'unico file d'ambiente che va versionato (non contiene segreti).
!.env.example
!**/.env.example
!deploy/.env.prod.example
!controllo/.env.example

# L'ARCHIVIO DELLE EVIDENZE NON SI VERSIONA MAI.
#
# `.archivio` è il percorso di ripiego dell'archivio su disco (`lib/storage/index.ts`):
# ogni documento caricato in sviluppo — un DVR, un certificato medico, una nomina — vi
# finisce dentro. Senza questa regola compare in `git status`, e al primo `git add -A` è
# nella storia per sempre. Tre file di prova c'erano già.
.archivio/
.dati/
