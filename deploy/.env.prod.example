# Configurazione di UN'ISTANZA. Si copia in `deploy/.env.prod` e si compila per cliente.
#
# QUESTO FILE NON VA MAI NEL REPOSITORY. `deploy/.env.prod` è in `.gitignore`, e
# `check-segreti.sh` lo verifica prima di ogni consegna: un segreto committato una volta
# resta nella storia di git per sempre, e cambiarlo dopo non lo toglie da lì.

# --- Il dominio dell'istanza ------------------------------------------------------------
# Un solo dominio per cliente. Il DNS deve puntare alla VPS PRIMA di alzare lo stack:
# Caddy chiede il certificato all'avvio, e senza risoluzione il rilascio si ferma lì.
DOMINIO=verdi.compliancedesk.it

# Vuoto in produzione: Caddy prende il certificato da Let's Encrypt.
# `tls internal` su una macchina senza DNS pubblico — è il caso del collaudo di ripristino.
# Deve contenere la DIRETTIVA INTERA: col solo `internal` Caddy non parte.
CADDY_TLS=

# --- Database ---------------------------------------------------------------------------
# La password si genera, non si sceglie:  openssl rand -base64 24
POSTGRES_USER=compliance
POSTGRES_PASSWORD=
POSTGRES_DB=compliance

# --- Segreto delle sessioni ---------------------------------------------------------------
# openssl rand -hex 32
#
# Non è un valore qualsiasi: chi lo conosce può forgiare una sessione valida per qualunque
# utenza dell'istanza. È diverso per ogni cliente, e l'applicazione si rifiuta di partire
# se trova ancora quello di sviluppo.
AUTH_SECRET=

# --- Il primo amministratore --------------------------------------------------------------
# Serve solo alla prima installazione, al servizio `preparazione`. Dopo si può togliere.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOME=
STUDIO_NOME=Studio Legale Esempio

# --- Comportamenti ------------------------------------------------------------------------
# `true` obbliga al cambio password al primo accesso, e SULLE ISTANZE VENDUTE DEVE RESTARE
# COSI'.
#
# Prima era `false` qui, nel compose e nello script di onboarding — tre punti che
# scavalcavano il default sicuro dello schema. Con `false` tutta la macchina
# `mustChangePassword` e' codice morto, e la password dell'amministratore resta quella
# scritta IN CHIARO in `.env.prod` sulla VPS, a tempo indefinito. Lo stesso file finisce
# dentro il backup.
#
# Il committente ha tolto il cambio forzato il 2026-08-03, ma per la VETRINA, dove le
# utenze si creano a mano per far provare il sistema e chi consegna la password la conosce
# gia'. Portarlo sulle istanze vendute era un'estensione che nessuno aveva deciso: li' la
# finestra fra la consegna delle credenziali e il primo accesso va chiusa.
#
# Si spegne per cliente quando c'e' una ragione, non per abitudine.
RICHIEDI_CAMBIO_PASSWORD=true

# --- Posta in uscita ----------------------------------------------------------------------
# NON SERVE UN PROVIDER TRANSAZIONALE. La casella arriva insieme al dominio Hostinger, che
# gestisce anche la zona DNS e quindi configura SPF e DKIM da solo. E' cio' che fa il
# progetto di riferimento in produzione, su cinque clienti.
#
# Hostinger e' lituana: la giurisdizione UE c'e' gia', senza un secondo fornitore, un secondo
# account e una seconda fattura.
#
# QUESTE CINQUE RIGHE SONO OBBLIGATORIE, e il riferimento non le documentava da nessuna
# parte: chi faceva l'onboarding doveva SAPERE di esportarle. Senza, l'istanza parte con
# `SMTP_HOST` vuoto, la posta non parte, e non c'e' errore — le mail restano semplicemente
# in coda. Con la registrazione pubblica chiusa, un utente che perde la password non ha
# altra strada.
#
# ─────────────────────────────────────────────────────────────────────────────────────────
# DUE MODI, E LA SCELTA VA FATTA PER CLIENTE
#
# Il progetto di riferimento si contraddice su questo punto: il suo `.env.prod.example` dice
# `smtp.cliente.it`, cioe' il relay DEL CLIENTE, mentre il suo script di onboarding manda da
# `no-reply@<dominio-brand>`. In produzione ha vinto il secondo, ma la scelta non e' mai
# stata presa: e' stata subita. Qui si dichiara.
#
#   A · IL NOSTRO DOMINIO (predefinito, i valori qui sotto)
#       Mittente `no-reply@compliancedesk.it`, casella nostra su Hostinger.
#       + funziona subito, senza chiedere niente al cliente
#       + SPF e DKIM li controlliamo noi, sulla zona che gestiamo gia'
#       − le credenziali sono LE STESSE su ogni istanza: una VPS compromessa manda posta
#         a nome del dominio di tutti gli altri clienti, e ne brucia la reputazione
#       − la mail arriva dal NOSTRO marchio, non da quello dello studio
#
#   B · IL DOMINIO DELLO STUDIO (si compila con i suoi valori)
#       Mittente `no-reply@studioverdi.it`, relay suo.
#       + nessuna credenziale condivisa: il danno resta dentro l'istanza
#       + la mail arriva dallo studio, che per chi la riceve e' piu' credibile
#       − serve che lo studio abbia un relay e sappia darci le credenziali
#       − SPF e DKIM sono suoi: se sbagliati, le mail finiscono nello spam e non
#         possiamo correggerlo noi
#
# REGOLA: si propone B a chi ha una posta aziendale vera, si usa A per tutti gli altri.
# Il codice non cambia — cambiano solo queste cinque righe.
# ─────────────────────────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=ops@compliancedesk.it
SMTP_PASSWORD=
# Il mittente e' un alias, non la casella: `no-reply@` dice a chi riceve che non deve
# rispondere, e tiene la casella operativa fuori dalle risposte automatiche.
SMTP_MITTENTE=no-reply@compliancedesk.it

# `cliente` è un'istanza normale. `vetrina` predispone i blocchi dimostrativi, che restano
# no-op finché il committente non li conferma.
ISTANZA_MODO=cliente
