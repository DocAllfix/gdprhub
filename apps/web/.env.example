# Configurazione dell'istanza. Copia in `.env` e compila.
# Le variabili sono validate all'avvio da src/lib/env.ts: se ne manca una obbligatoria,
# l'applicazione si rifiuta di partire con un messaggio chiaro.

# URL pubblico dell'istanza.
APP_URL=http://localhost:3000

# Postgres. Su Vercel è Neon (region EU); in produzione il container dello stack.
# DATABASE_URL=postgresql://utente:password@host:5432/gdprhub

# --- I due soli interruttori che cambiano fra vetrina e produzione -------------------
#
#   vetrina Vercel      STORAGE_DRIVER=blob    PDF_DRIVER=serverless
#   istanza dedicata    STORAGE_DRIVER=fs      PDF_DRIVER=local
#
# Tutto il resto del codice non sa dove sta girando.

# Dove finiscono le evidenze documentali: blob | fs
STORAGE_DRIVER=fs
STORAGE_FS_ROOT=./.dati/evidenze

# Come si rende il PDF: serverless | local
PDF_DRIVER=local
# Percorso esplicito del Chromium di sistema (immagine Docker). Senza, usa quello di Playwright.
# PDF_CHROMIUM_PATH=/usr/bin/chromium

# --- Telemetria ---------------------------------------------------------------------
# Spenta di default: un'istanza che manda tracce a un servizio esterno fa uscire dati
# dal server del cliente, e in un prodotto GDPR va dichiarato per iscritto.
# SENTRY_DSN=
