# Configurazione della macchina di controllo. Si copia in `controllo/.env`.
#
# QUESTO FILE NON VA MAI NEL REPOSITORY. `controllo/.env` e' in `.gitignore`, e
# `check-segreti.sh` lo verifica.

# --- Il dominio della macchina di controllo -----------------------------------------------
# Un sottodominio nostro, che NON deve comparire nei motori di ricerca: il suo indirizzo dice
# a chiunque dove guardare per trovare, in un posto solo, lo stato di tutta la flotta.
DOMINIO=controllo.legisboard.it

# --- Chi puo' aprire l'amministrazione ----------------------------------------------------
# Indirizzi separati da spazio, anche in notazione CIDR. Da questa interfaccia si leggono le
# tracce di errore dei clienti di tre prodotti: e' la superficie piu' concentrata che
# possediamo, e l'unica che non ha bisogno di essere pubblica.
#
# L'INGESTIONE resta aperta a tutti: ci scrivono le istanze, che stanno su indirizzi che non
# conosciamo in anticipo.
IP_AMMESSI=

# --- GlitchTip ----------------------------------------------------------------------------
# openssl rand -hex 32
GLITCHTIP_SECRET=
GLITCHTIP_DB_PASSWORD=

# --- Gatus --------------------------------------------------------------------------------
GATUS_DB_PASSWORD=
# Protegge gli endpoint del battito: senza, chiunque potrebbe dichiarare sana un'istanza
# spenta, che e' il modo piu' silenzioso di disattivare una sorveglianza.
#   openssl rand -hex 24
GATUS_TOKEN=

# --- Allarmi ------------------------------------------------------------------------------
# Telegram perche' arriva sul telefono senza aprire la posta: un'istanza giu' alle undici di
# sera non aspetta la prossima lettura della casella.
TELEGRAM_TOKEN=
TELEGRAM_CHAT=

# --- Posta (per gli inviti a GlitchTip e i rapporti) --------------------------------------
SMTP_MITTENTE=no-reply@legisboard.it
EMAIL_URL=smtp+tls://utente:password@smtp.esempio.it:587
